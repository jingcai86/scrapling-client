{
  "name": "scrapling-client",
  "version": "1.0.0",
  "description": "Generic TypeScript / Node.js client and modular web scraping framework for Scrapling MCP servers",
  "type": "module",
  "main": "dist/core/index.js",
  "types": "dist/core/index.d.ts",
  "exports": {
    ".": "./core/index.ts",
    "./core/*": "./core/*"
  },
  "scripts": {
    "start": "tsx server/index.ts",
    "dev": "tsx watch server/index.ts",
    "build:ui": "npm run --prefix frontend build",
    "dev:ui": "npm run --prefix frontend start",
    "test": "tsx --test */*.test.ts",
    "db:init": "tsx scripts/init-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:ui && tsc",
    "commitlint": "commitlint",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.30.5",
    "husky": "^9.1.7",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "drizzle-orm": "^0.40.0",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "resend": "^6.34.1"
  }
}
