# Required Boot & Database Environment (.env Only — Read-Only in UI, Requires Restart)
PORT=80
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Initial Seed Values for PostgreSQL `scrapling.config`
# (Seeded on first startup; if omitted here, created in `scrapling.config` with empty string "")
TZ=America/Los_Angeles
SCRAPLING_MCP_URL=http://localhost:8000/mcp
SCRAPLING_TIMEOUT_MS=60000

# Daily Randomized Cron Scheduler (e.g., 19:00 + 0..60m random jitter = 7:00 PM to 8:00 PM)
CRON_ENABLED=true
CRON_BASE_TIME=19:00
CRON_JITTER_MINUTES=60

# Resend Email Alert Configuration (triggers when discount >= threshold %)
EMAIL_ENABLED=false
RESEND_API_KEY=
ALERT_EMAIL_FROM="Deal Alerts <onboarding@resend.dev>"
ALERT_EMAIL_TO=
ALERT_DISCOUNT_THRESHOLD_PCT=20
